# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Use the Session pooler connection string (port 5432) — Supabase's direct
# connection (db.PROJECT_REF.supabase.co) is IPv6-only and won't resolve on
# most networks/CI runners. Get it from Project Settings > Connect > Session
# pooler; the username becomes `<role>.PROJECT_REF`.
#
# DATABASE_URL is what the running app connects with. It MUST be a role
# WITHOUT the BYPASSRLS attribute (Supabase's own `postgres` role has
# BYPASSRLS, so Row-Level Security enforces nothing if the app connects as
# it — see docs/progress.md). Create a dedicated restricted role, e.g.:
#   CREATE ROLE app_role LOGIN PASSWORD '...' NOBYPASSRLS;
#   GRANT USAGE ON SCHEMA public TO app_role;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO app_role;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO app_role;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO app_role;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO app_role;
DATABASE_URL=postgresql+asyncpg://app_role.PROJECT_REF:CHANGE_ME@aws-1-REGION.pooler.supabase.com:5432/postgres
# MIGRATION_DATABASE_URL: the elevated `postgres` role, used only by alembic
# for DDL (needs to create tables/types/extensions). Falls back to
# DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:CHANGE_ME@aws-1-REGION.pooler.supabase.com:5432/postgres

# ── Supabase (storage + service role) ────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME        # backend only — never ship to frontend
SUPABASE_RECEIPTS_BUCKET=receipts          # private bucket for receipt/ledger images

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=CHANGE_ME
GEMINI_FLASH_MODEL=gemini-2.5-flash        # intent classification, tools, composition
GEMINI_PRO_MODEL=gemini-2.5-pro            # receipt vision parsing
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME              # HMAC key for X-Hub-Signature-256 validation
WHATSAPP_VERIFY_TOKEN=CHANGE_ME            # arbitrary string, must match Meta webhook config
WHATSAPP_ALERT_TEMPLATE=business_alert     # approved Utility template name
WHATSAPP_OTP_TEMPLATE=login_otp            # approved Authentication template name
WHATSAPP_TEMPLATE_LANGUAGE=id

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
OWNER_TOKEN_TTL_MINUTES=720                # 12h dashboard session
POS_TOKEN_TTL_MINUTES=720                  # 12h kiosk shift session

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                    # development | production
FRONTEND_ORIGIN=http://localhost:3000
LOW_STOCK_DAYS_THRESHOLD=3                 # stock-velocity alert threshold (days remaining)
