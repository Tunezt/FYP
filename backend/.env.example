# ── Database ─────────────────────────────────────────────────────────────────
# Local Postgres 16 + pgvector is the development default (roadmap M0-T1):
#   docker compose up -d                 # or, with no Docker:  python scripts/local-pg.py start
# Both create superuser postgres/postgres, database warung_pintar, and run
# scripts/db-bootstrap.sql, which creates the restricted `app_role` below.
#
# DATABASE_URL is what the running app connects with. It MUST be a role
# WITHOUT the BYPASSRLS attribute. The `postgres` superuser has BYPASSRLS, so
# Row-Level Security enforces nothing if the app connects as it — and every
# isolation test still passes, because the tests connect as the same role.
# Never point this at the elevated role, not even to debug.
DATABASE_URL=postgresql+asyncpg://app_role:app_role@localhost:5432/warung_pintar
# MIGRATION_DATABASE_URL: the elevated role, used only by alembic for DDL
# (creates tables, types, extensions). Falls back to DATABASE_URL if unset.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/warung_pintar
# The DB-integration tests (tests/test_db_integration.py) use DATABASE_URL
# automatically when it points at localhost; set INTEGRATION_DATABASE_URL to
# override.
#
# Supabase (deploy target): use the Session pooler string (port 5432) — the
# direct host is IPv6-only and won't resolve on most networks. Create
# `app_role` there by running scripts/db-bootstrap.sql in the SQL editor
# after the first `alembic upgrade head`. The username becomes `<role>.PROJECT_REF`:
#   DATABASE_URL=postgresql+asyncpg://app_role.PROJECT_REF:CHANGE_ME@aws-1-REGION.pooler.supabase.com:5432/postgres
#   MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:CHANGE_ME@aws-1-REGION.pooler.supabase.com:5432/postgres

# ── Supabase (storage + service role) ────────────────────────────────────────
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME        # backend only — never ship to frontend
SUPABASE_RECEIPTS_BUCKET=receipts          # private bucket for receipt/ledger images

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Google AI Studio keys may come as either AIzaSy... or the newer AQ.... format
# — both are valid, google-genai accepts either.
GOOGLE_API_KEY=CHANGE_ME
GEMINI_FLASH_MODEL=gemini-2.5-flash        # intent classification, tools, composition
# gemini-2.5-pro has a hard 0-request free-tier quota on some Google accounts
# (limit:0, not rate-limiting — confirmed via a live 429 RESOURCE_EXHAUSTED with
# "limit: 0" in the violation detail). Requires billing enabled on the Google
# Cloud project to use at all. Flash was tested on real handwritten receipts
# (see docs/progress.md + docs/vision-test-samples/) and performs well, so it's
# a safe default for vision until Pro access is confirmed on your account.
GEMINI_PRO_MODEL=gemini-2.5-flash          # receipt vision parsing (see note above)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME              # HMAC key for X-Hub-Signature-256 validation
WHATSAPP_VERIFY_TOKEN=CHANGE_ME            # arbitrary string, must match Meta webhook config
WHATSAPP_ALERT_TEMPLATE=business_alert     # approved Utility template name
WHATSAPP_OTP_TEMPLATE=login_otp            # approved Authentication template name
WHATSAPP_TEMPLATE_LANGUAGE=id

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
OWNER_TOKEN_TTL_MINUTES=720                # 12h dashboard session
POS_TOKEN_TTL_MINUTES=720                  # 12h kiosk shift session

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                    # development | production
FRONTEND_ORIGIN=http://localhost:3000
LOW_STOCK_DAYS_THRESHOLD=3                 # stock-velocity alert threshold (days remaining)
