{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd backend && .venv\\Scripts\\python.exe dev.py"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd frontend && npm run dev"
      ],
      "port": 3000
    }
  ]
}
